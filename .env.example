# このファイルを .env にコピーして設定してください
# cp .env.example .env

# --- ローカルLLM(既定バックエンド) ---
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen3:8b

# --- Claude API(backend="claude" 指定時のみ必要) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI API(backend="openai" 指定時のみ必要) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# --- Gemini API(backend="gemini" 指定時のみ必要。Google AI Studioで発行) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.8-flash

# --- xAI Grok API(backend="grok" 指定時のみ必要) ---
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XAI_MODEL=grok-4.6

# --- Meta Llama API(backend="meta" 指定時のみ必要。Llama API の開発者コンソールで発行) ---
# OpenAI互換エンドポイントを使う。モデル名は Llama API で利用可能なものに合わせて変更する。
LLAMA_API_KEY=LLM|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# LLAMA_BASE_URL=https://api.llama.com/compat/v1/
